MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=skku_notices
CRAWLER_ENV=development
LOG_FORMAT=dev
AI_SERVICE_URL=http://127.0.0.1:4000

# FCM dispatch ping — points to the api-1 container in the same docker network
# (the skkuverse bridge network on the OCI VM). Both vars must be set together;
# either missing disables the ping and the server's safety-net cron at 30-min
# intervals drains the queue instead. Boot logs ERROR if exactly one is set.
DISPATCH_URL=http://api-1:3000/internal/notices/dispatch-pending
INTERNAL_DISPATCH_TOKEN=

# ── bus (adr-008) ─────────────────────────────────────────────────────────
# ⚠️ DEPLOY ORDER. The container runs `start` with no --module, so it selects
# every family, and in the production profile a SELECTED family that is
# unconfigured is a boot REFUSAL — not a skip. Ship these to the VM's .env
# BEFORE merging bus, or the deploy exits non-zero and rolls back.
#
# All five are secrets. MONGO_DB_NAME_BUS_CAMPUS must match the value
# skkuverse-server already uses; the crawler applies the same _dev/_test
# suffix rule the server's devDbName() does.
MONGO_DB_NAME_BUS_CAMPUS=
# The whole URL is the credential for this upstream. Production never falls
# back to _DEV.
API_HSSC_NEW_PROD=
API_HSSC_NEW_DEV=
# Must be URL-encoded (A-Za-z0-9_%-). An un-encoded key does not error — it
# produces a well-formed request that simply never authenticates, so the
# module refuses one at construction rather than at tick time.
SEOUL_BUS_SERVICE_KEY=
# Naver Directions, for campus ETA. Its own family (`bus-eta`): losing these
# skips campus ETA without touching the shuttle board.
NAVER_API_KEY_ID=
NAVER_API_KEY=
